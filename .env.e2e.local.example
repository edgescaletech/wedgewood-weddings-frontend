# Unset E2E_BASE_URL to let Playwright start Vite on localhost:4175.
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:8080
E2E_API_MODE=proxy

# Controlled tests run by default. Enable backend and WorkOS checks explicitly.
E2E_GO_AUTH=0
E2E_LIVE_AUTH=0
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_INACTIVE_EMAIL=
E2E_INACTIVE_PASSWORD=

# Batch 2. Use an existing Monday with events in all three venues.
E2E_AUTHZ_WEEK=
E2E_AUTHZ_VENUE_A=Hofmann Ranch
E2E_AUTHZ_VENUE_B=Tapestry House
E2E_AUTHZ_VENUE_C=Abbey Catering
# Enables role reset, revocation and restoration on the dedicated mixed-role account.
E2E_AUTHZ_MUTATIONS=0
