# Public backend URL used by all API and authentication requests.
# Copy this file to .env for local development and set your backend URL.
VITE_API_BASE_URL=http://localhost:8080

# Optional. Match the minimum password length configured in WorkOS AuthKit.
# The provider enforces its full password policy.
# VITE_WORKOS_PASSWORD_MIN_LENGTH=12

# Leave empty to use the frontend origin with a reverse proxy for /api and /auth.
# VITE_API_BASE_URL=
# Vite embeds VITE_* values in the browser bundle. Never put secrets here.
# Restart the dev server or rebuild after changing this value.
