# Replace both placeholder origins with deployment URLs verified as staging.
E2E_BASE_URL=https://scheduler-staging.example.test
E2E_API_URL=https://api-staging.example.test
E2E_API_MODE=proxy
E2E_STAGING_ALLOWED_ORIGINS=https://scheduler-staging.example.test,https://api-staging.example.test

# Set to 1 only after confirming the deployment uses isolated PostgreSQL
# and a dedicated WorkOS test environment.
E2E_STAGING_ISOLATED=0
E2E_GO_AUTH=0
E2E_LIVE_AUTH=0
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_INACTIVE_EMAIL=
E2E_INACTIVE_PASSWORD=

# Batch 2. Use an existing Monday with events in all three venues.
E2E_AUTHZ_WEEK=
E2E_AUTHZ_VENUE_A=Hofmann Ranch
E2E_AUTHZ_VENUE_B=Tapestry House
E2E_AUTHZ_VENUE_C=Abbey Catering
# Enables role reset, revocation and restoration on the dedicated mixed-role account.
E2E_AUTHZ_MUTATIONS=0
